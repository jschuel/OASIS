universe   = vanilla
getenv     = True

request_gpus   = 2
request_cpus   = 8
request_memory = 24GB

# Require 2×A100
requirements = (TotalGPUs >= 2) && ( regexp("A100", GPUs_DeviceName) || regexp("TITAN RTX", GPUs_DeviceName) )
# IMPORTANT: run in your repo, not in /scratch
initialdir = /mercury/data3/jschueler1/OASIS/OASIS

executable = $(initialdir)/run_train.sh

environment = \
  "TORCHRUN=/opt/ppd/software/miniforge3/envs/MIGDAL_Py310/bin/torchrun \
   RC=$(rc) RN=$(rn) RO=$(ro) RUN_ID=$(run_id) \
   DATA_ROOT=$(data_root) MODEL_ROOT=$(model_root) \
   SEED=$(seed) EPOCHS=$(epochs) PATIENCE=$(patience) \
   BATCH_SIZE=$(batch_size) LR=$(lr)"

log    = condor_logs/train_$(run_id).log
output = condor_logs/train_$(run_id).out
error  = condor_logs/train_$(run_id).err

should_transfer_files = YES
when_to_transfer_output = ON_EXIT
